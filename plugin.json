{
  "id": "io.github.aurakomputer.filemanager",
  "name": "File Manager",
  "version": "0.1.0",
  "api_version": 1,
  "server": {
    "command": ["bun", "server/main.ts"],
    "lifecycle": "on_demand"
  },
  "webapp": {
    "bundle_path": "webapp/dist/main.js",
    "style_path": "webapp/dist/style.css"
  },
  "capabilities": ["http"],
  "permissions": ["network"],
  "http": {
    "listen": "unix"
  }
}
